<?xml version="1.0" encoding="UTF-8"?>
<manifest>

	<remote name="zy" fetch="https://github.com/zyexro" />
	<remote name="mindthegapps" fetch="https://gitlab.com/MindTheGapps" />
   <!-- <remote name="LOS" fetch="https://github.com/LineageOS" /> -->

  <!-- device tree -->
  <project path="device/xiaomi/blossom" name="android_device_xiaomi_blossom" remote="zy" revision="sixteen" />

  <!-- SELinux policies -->
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="zy" revision="sixteen" />

  <!-- hardware supports -->
  <project path="hardware/mediatek" name="android_hardware_mediatek" remote="zy" revision="sixteen" />

  <!-- kernel tree -->
  <project path="device/xiaomi/blossom-kernel" name="android_device_xiaomi_blossom-kernel" remote="zy" revision="sixteen" >
    <linkfile src="headers" dest="kernel/xiaomi/blossom" />
  </project>

  <!-- vendor tree -->
  <project path="vendor/xiaomi/blossom" name="proprietary_vendor_xiaomi_blossom" remote="zy" revision="sixteen" />

  <!-- Samsung NFC
  -->
  <remove-project path="hardware/samsung/nfc"/>
  <project path="hardware/samsung/nfc" name="android_hardware_samsung_nfc" remote="zy" revision="sixteen" />

  <!-- RevampedFMRadio -->
  <project path="packages/apps/RevampedFMRadio" name="android_packages_apps_RevampedFMRadio" remote="zy" revision="sixteen" />
  <remove-project path="packages/apps/FMRadio"/>

 <!-- GApps --> 
  <project path="vendor/gapps" name="vendor_gapps" remote="mindthegapps" revision="baklava" />

</manifest>
